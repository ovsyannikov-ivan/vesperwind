{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Vesperwind",
  "version": "0.1.0",
  "identifier": "com.vesperwind.desktop",
  "build": {
    "beforeDevCommand": "npm run dev:frontend -- --port 1420",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: blob: vesperwind-media: http://127.0.0.1:*; media-src 'self' blob: vesperwind-media: http://127.0.0.1:*; connect-src 'self' ipc: http://ipc.localhost vesperwind-media: http://127.0.0.1:*; style-src 'self' 'unsafe-inline'; font-src 'self' data:; worker-src 'self' blob:",
      "dangerousDisableAssetCspModification": [
        "style-src"
      ]
    },
    "windows": [
      {
        "label": "main",
        "title": "Vesperwind",
        "width": 1440,
        "height": 900,
        "minWidth": 960,
        "minHeight": 600,
        "resizable": true,
        "backgroundColor": "#1c1c1e",
        "dragDropEnabled": false
      }
    ]
  },
  "bundle": {
    "externalBin": [
      "binaries/vesperwind-archive"
    ],
    "active": true,
    "targets": "all",
    "resources": [
      "binaries/libarchive-LICENSE.txt",
      "binaries/zlib-LICENSE.txt",
      "binaries/archive-BUILD-INFO.json",
      "vendor/libmpv/**/*",
      "vendor/lowa/**/*"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}

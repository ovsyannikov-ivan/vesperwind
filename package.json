{
  "name": "vesperwind-file-manager",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A cross-platform, desktop-first dual-pane file manager and remote workspace.",
  "scripts": {
    "dev": "node scripts/dev.js",
    "dev:backend": "node server/index.js",
    "dev:frontend": "vite --host 127.0.0.1",
    "predev:tauri": "node scripts/check-native-prereqs.mjs && node scripts/check-thumbnail-ffmpeg.mjs && node scripts/check-archive-worker.js && node scripts/check-lowa-assets.mjs",
    "dev:tauri": "tauri dev",
    "build": "node scripts/check-lowa-assets.mjs && vite build",
    "prebuild:tauri": "node scripts/check-native-prereqs.mjs && node scripts/check-thumbnail-ffmpeg.mjs && node scripts/check-archive-worker.js && node scripts/check-lowa-assets.mjs",
    "build:tauri": "node scripts/build-tauri.js",
    "build:staging": "node scripts/build-staging.js",
    "build:sea": "node scripts/build-sea.js",
    "postinstall": "node scripts/ensure-node-pty-helper.js",
    "start": "node server/index.js",
    "test": "node scripts/test.js",
    "test:smoke": "node scripts/runtime-smoke.js",
    "build:archives": "node scripts/build-archive-worker.js"
  },
  "dependencies": {
    "@docx-editor.dev/core": "2.22.0",
    "@docx-editor.dev/fonts": "2.22.0",
    "@docx-editor.dev/vue": "2.22.0",
    "@mdi/font": "^7.4.47",
    "@tauri-apps/api": "^2.11.1",
    "@univerjs/preset-sheets-core": "1.0.2",
    "@univerjs/presets": "1.0.2",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "bootstrap": "5.3.8",
    "media-chrome": "^4.19.2",
    "monaco-editor": "^0.56.0",
    "node-pty": "^1.1.0",
    "pdfjs-dist": "^6.3.289",
    "socket.io": "^4.8.1",
    "socket.io-client": "^4.8.1",
    "ssh2": "^1.17.0",
    "vue": "^3.5.42",
    "xlsx": "file:vendor/xlsx-0.20.3.tgz"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.11.4",
    "@vitejs/plugin-vue": "^6.0.1",
    "esbuild": "^0.28.2",
    "vite": "^7.1.5"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "allowScripts": {
    "cpu-features@0.0.10": true,
    "esbuild@0.28.2": true,
    "fsevents@2.3.3": true,
    "node-pty@1.1.0": true,
    "protobufjs@7.6.6": true,
    "ssh2@1.17.0": true
  }
}
